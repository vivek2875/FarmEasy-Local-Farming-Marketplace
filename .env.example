# Copy this file to .env for local development. Never commit the real .env.
FARMEASY_DB_HOST=127.0.0.1
FARMEASY_DB_PORT=3306
FARMEASY_DB_NAME=farmeasy
FARMEASY_DB_USER=root
FARMEASY_DB_PASSWORD=

# FarmEasy Mandi Price and Supply Intelligence (Python/PostgreSQL analytics)
# Keep this separate from the legacy MySQL marketplace database.
FARMEASY_ANALYTICS_DATABASE_URL=postgresql+psycopg://farmeasy_pipeline:change-me@127.0.0.1:5432/farmeasy_analytics
FARMEASY_ANALYTICS_DATA_GOV_API_KEY=
# Public resource identifier (current nationwide daily mandi-price dataset).
FARMEASY_ANALYTICS_DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
FARMEASY_ANALYTICS_DATA_GOV_API_URL=https://api.data.gov.in/resource
FARMEASY_ANALYTICS_PRICE_UNIT=INR/quintal
FARMEASY_ANALYTICS_PAGE_SIZE=1000
FARMEASY_ANALYTICS_LOOKBACK_DAYS=90
FARMEASY_ANALYTICS_REQUEST_TIMEOUT_SECONDS=30
FARMEASY_ANALYTICS_MAX_RETRIES=3
FARMEASY_ANALYTICS_RETRY_BACKOFF_SECONDS=0.5
FARMEASY_ANALYTICS_STALE_AFTER_DAYS=3
FARMEASY_ANALYTICS_SUSPICIOUS_CHANGE_PCT=75
FARMEASY_ANALYTICS_ENABLE_ARRIVALS=false
FARMEASY_ANALYTICS_LOG_LEVEL=INFO
# The API is read-only. A value of 0 disables this single-process guard for a
# private network only; retain a gateway-level rate limit for public deployments.
FARMEASY_ANALYTICS_API_RATE_LIMIT_PER_MINUTE=120
# Set a long random token before exposing the API beyond a trusted private network.
# Clients pass it using the X-Analytics-Token header; never place it in browser code.
FARMEASY_ANALYTICS_API_ACCESS_TOKEN=
# Comma-separated browser origins. Keep blank for server-to-server PHP integration.
FARMEASY_ANALYTICS_API_ALLOWED_ORIGINS=
