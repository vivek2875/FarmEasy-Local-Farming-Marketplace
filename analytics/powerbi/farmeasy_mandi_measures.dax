// FarmEasy Mandi Price and Supply Intelligence — Power BI measures
// Expected imported table names are documented in powerbi/README.md.
// Format price measures as decimal/currency with the source's stored unit,
// normally INR/quintal. Do not relabel it as INR/kg without a documented conversion.

Average Modal Price =
AVERAGE ( 'Mandi Price Observations'[modal_price] )

Median Modal Price =
MEDIAN ( 'Mandi Price Observations'[modal_price] )

Minimum Reported Price =
MIN ( 'Mandi Price Observations'[min_price] )

Maximum Reported Price =
MAX ( 'Mandi Price Observations'[max_price] )

Average Price Spread =
AVERAGE ( 'Mandi Price Observations'[price_spread] )

Average Price Spread % =
AVERAGE ( 'Mandi Price Observations'[price_spread_pct] )

Latest Report Date =
MAX ( 'Mandi Price Observations'[market_date] )

Latest Average Modal Price =
VAR LatestDate = [Latest Report Date]
RETURN
    CALCULATE (
        [Average Modal Price],
        KEEPFILTERS ( 'Mandi Price Observations'[market_date] = LatestDate )
    )

Latest Median Modal Price =
VAR LatestDate = [Latest Report Date]
RETURN
    CALCULATE (
        [Median Modal Price],
        KEEPFILTERS ( 'Mandi Price Observations'[market_date] = LatestDate )
    )

7-Day Average Modal Price =
VAR EndingDate = [Latest Report Date]
RETURN
    CALCULATE (
        [Average Modal Price],
        DATESINPERIOD ( 'Dim Date'[full_date], EndingDate, -7, DAY )
    )

30-Day Average Modal Price =
VAR EndingDate = [Latest Report Date]
RETURN
    CALCULATE (
        [Average Modal Price],
        DATESINPERIOD ( 'Dim Date'[full_date], EndingDate, -30, DAY )
    )

Week-over-Week Change =
[Latest Average Modal Price]
    - CALCULATE ( [Latest Average Modal Price], DATEADD ( 'Dim Date'[full_date], -7, DAY ) )

Week-over-Week Change % =
VAR PriorValue =
    CALCULATE ( [Latest Average Modal Price], DATEADD ( 'Dim Date'[full_date], -7, DAY ) )
RETURN
    DIVIDE ( [Latest Average Modal Price] - PriorValue, PriorValue )

Month-over-Month Change =
[Latest Average Modal Price]
    - CALCULATE ( [Latest Average Modal Price], DATEADD ( 'Dim Date'[full_date], -1, MONTH ) )

Month-over-Month Change % =
VAR PriorValue =
    CALCULATE ( [Latest Average Modal Price], DATEADD ( 'Dim Date'[full_date], -1, MONTH ) )
RETURN
    DIVIDE ( [Latest Average Modal Price] - PriorValue, PriorValue )

Modal Price Standard Deviation =
STDEV.S ( 'Mandi Price Observations'[modal_price] )

Modal Price Coefficient of Variation % =
DIVIDE ( [Modal Price Standard Deviation], [Average Modal Price] )

Active Reporting Mandis =
VAR LatestDate = [Latest Report Date]
RETURN
    CALCULATE (
        DISTINCTCOUNT ( 'Mandi Price Observations'[market_key] ),
        KEEPFILTERS ( 'Mandi Price Observations'[market_date] = LatestDate )
    )

Commodities Covered =
DISTINCTCOUNT ( 'Mandi Price Observations'[commodity_key] )

Data Freshness Days =
DATEDIFF ( [Latest Report Date], TODAY (), DAY )

Suspicious Price Observations =
CALCULATE (
    COUNTROWS ( 'Mandi Price Observations' ),
    'Mandi Price Observations'[quality_status] = "suspicious"
)

Warning Price Observations =
CALCULATE (
    COUNTROWS ( 'Mandi Price Observations' ),
    'Mandi Price Observations'[quality_status] = "warning"
)

Highest Volatility Commodity =
VAR TopCommodity =
    TOPN (
        1,
        ALLSELECTED ( 'Volatility' ),
        'Volatility'[modal_price_coefficient_of_variation_pct], DESC,
        'Volatility'[observation_count], DESC
    )
RETURN
    CONCATENATEX ( TopCommodity, 'Volatility'[commodity_name], ", " )

Highest Volatility CV % =
MAXX (
    TOPN (
        1,
        ALLSELECTED ( 'Volatility' ),
        'Volatility'[modal_price_coefficient_of_variation_pct], DESC
    ),
    'Volatility'[modal_price_coefficient_of_variation_pct]
)

Best Mandi Name =
VAR EligibleMarkets =
    FILTER (
        ALLSELECTED ( 'Latest Market Comparison' ),
        'Latest Market Comparison'[quality_status] <> "suspicious"
    )
VAR TopMarket =
    TOPN (
        1,
        EligibleMarkets,
        'Latest Market Comparison'[modal_price], DESC,
        'Latest Market Comparison'[market_date], DESC,
        'Latest Market Comparison'[market_name], ASC
    )
RETURN
    CONCATENATEX ( TopMarket, 'Latest Market Comparison'[market_name], ", " )

Best Mandi Latest Modal Price =
MAXX (
    TOPN (
        1,
        FILTER (
            ALLSELECTED ( 'Latest Market Comparison' ),
            'Latest Market Comparison'[quality_status] <> "suspicious"
        ),
        'Latest Market Comparison'[modal_price], DESC,
        'Latest Market Comparison'[market_date], DESC
    ),
    'Latest Market Comparison'[modal_price]
)

Expected Reporting Days =
SUM ( 'Reporting Coverage'[expected_reporting_days] )

Missing Reporting Days =
SUM ( 'Reporting Coverage'[missing_reporting_days] )

Missing Reporting Rate % =
DIVIDE ( [Missing Reporting Days], [Expected Reporting Days] )

Latest Successful Run Id =
VAR LatestRun =
    TOPN (
        1,
        FILTER ( ALL ( 'Data Quality' ), 'Data Quality'[status] = "succeeded" ),
        'Data Quality'[completed_at], DESC,
        'Data Quality'[run_id], DESC
    )
RETURN
    MAXX ( LatestRun, 'Data Quality'[run_id] )

Last Successful Pipeline Run =
VAR LatestRun =
    TOPN (
        1,
        FILTER ( ALL ( 'Data Quality' ), 'Data Quality'[status] = "succeeded" ),
        'Data Quality'[completed_at], DESC,
        'Data Quality'[run_id], DESC
    )
RETURN
    MAXX ( LatestRun, 'Data Quality'[completed_at] )

Raw Rows Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        MAX ( 'Data Quality'[raw_rows_received] ),
        'Data Quality'[run_id] = LatestRunId
    )

Valid Rows Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        MAX ( 'Data Quality'[valid_rows_loaded] ),
        'Data Quality'[run_id] = LatestRunId
    )

Rejected Rows Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        MAX ( 'Data Quality'[invalid_rows_rejected] ),
        'Data Quality'[run_id] = LatestRunId
    )

Duplicate Rows Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        MAX ( 'Data Quality'[duplicates_removed] ),
        'Data Quality'[run_id] = LatestRunId
    )

Stale Markets Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        MAX ( 'Data Quality'[stale_market_count] ),
        'Data Quality'[run_id] = LatestRunId
    )

Missing Field Issues Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        COUNTROWS ( 'Data Quality Issues' ),
        'Data Quality Issues'[run_id] = LatestRunId,
        'Data Quality Issues'[issue_code] = "missing_required_value"
    )

Suspicious Price Issues Latest Run =
VAR LatestRunId = [Latest Successful Run Id]
RETURN
    CALCULATE (
        COUNTROWS ( 'Data Quality Issues' ),
        'Data Quality Issues'[run_id] = LatestRunId,
        'Data Quality Issues'[issue_code] = "suspicious_price_change"
    )

// Enable only after the optional verified-arrivals source and fact table are deployed.
// Total Arrival Quantity (kg) = SUM ( 'Market Arrivals'[arrival_quantity_kg] )
// Arrival Trend 30-Day Average (kg) =
// CALCULATE ( [Total Arrival Quantity (kg)], DATESINPERIOD ( 'Dim Date'[full_date], MAX ( 'Dim Date'[full_date] ), -30, DAY ) )
